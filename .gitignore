# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Hóa đơn THẬT chưa ẩn danh — KHÔNG BAO GIỜ commit.
# Hóa đơn điện tử mang PII (tên, email, mã khách hàng, MST, số tài khoản) và cả
# chứng thư số thật. gitleaks KHÔNG bắt được thứ này — nó tìm token, không tìm PII.
# Bản đã ẩn danh nằm ở tests/fixtures/real_samples/ và được commit có chủ đích.
# PDF cũng bị chặn: nhà cung cấp gửi ZIP chứa CẢ .xml lẫn .pdf, và bản PDF mang
# đúng PII đó ở dạng người đọc được + QR tra cứu. M3.4 có cần mẫu PDF cho nhánh
# vision, nhưng phải là bản đã ẩn danh đặt trong tests/fixtures/.
# KHÔNG neo `/` — nhà cung cấp giao hóa đơn trong THƯ MỤC (vd
# PC06BB0378706…/ chứa .xml + 2 bản .pdf). Neo root chỉ chặn được file rời và
# để lọt nguyên thư mục; đã suýt lọt 2 PDF có số CCCD vì lỗi này.
# Bản ẩn danh nằm dưới tests/ nên được whitelist lại ngay bên dưới.
*.xml
*.pdf
*.zip
!tests/**/*.xml
!tests/**/*.pdf
!docs/**/*.pdf
invoices_raw/

# Environment — KHÔNG BAO GIỜ commit key.
# Bài học từ Project A: .claude/settings.json ở đó chứa LANGFUSE_SECRET_KEY
# plaintext. May là .claude/ đã bị ignore nên key chưa vào git history, nhưng
# đó là may chứ không phải thiết kế. Ở đây ignore từ đầu + gitleaks trong CI.
.env
.env.*
!.env.example
.claude/settings.local.json

# uv.lock — repo này khoá version bằng `requirements.lock` (uv pip compile).
# `uv run` tự sinh uv.lock và re-resolve từ pyproject, tạo lock thứ hai lệch
# với cái đầu. Một nguồn sự thật thôi; CI gọi thẳng .venv/bin/… để tránh hẳn.
uv.lock

# Test / tooling cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Docker volume
postgres_data/

# LLM replay fixtures là artefact sinh ra, không phải source.
# (Ngoại lệ: fixture đã curate cho CI thì commit — xem tests/fixtures/llm_cache/)
tests/fixtures/llm_cache/*.tmp

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
