config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	route_source(route_source)
	parse_xml(parse_xml)
	vision_extract(vision_extract)
	validate(validate)
	signals(signals)
	manual_queue(manual_queue)
	__end__([<p>__end__</p>]):::last
	__start__ --> route_source;
	parse_xml --> validate;
	route_source -.-> parse_xml;
	route_source -.-> vision_extract;
	validate -.-> manual_queue;
	validate -. &nbsp;__end__&nbsp; .-> signals;
	validate -.-> vision_extract;
	vision_extract --> validate;
	manual_queue --> __end__;
	signals --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
