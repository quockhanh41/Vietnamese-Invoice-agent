# Copy thành .env. `.env` đã nằm trong .gitignore và gitleaks quét mọi commit
# — nhưng lớp phòng thủ tốt nhất vẫn là không dán key thật vào file nào bị track.

# --- Database ---------------------------------------------------------------
# Khớp docker-compose.yml (cổng 5433, không phải 5432).
DATABASE_URL=postgresql://invoice:invoice@localhost:5433/invoice_agent

# --- LLM --------------------------------------------------------------------
# Danh sách phân tách bằng dấu phẩy, KHÔNG phải JSON array.
# Dạng số ít (GROQ_API_KEY) cũng dùng được — số nhiều thắng nếu có cả hai.
GROQ_API_KEYS=
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
OPENAI_API_KEY=

# Để trống thì dùng chain mặc định trong config.py.
# LLM_MODEL_CHAIN=groq/llama-3.3-70b-versatile,gemini/gemini-3.5-flash

# live | record | replay — replay đọc fixture, không chạm mạng (CI dùng cái này).
LLM_MODE=live

# --- Batch ------------------------------------------------------------------
# Kiểm soát CHÍNH chống 429 khi fan-out; key rotation chỉ là lưới đỡ.
MAX_CONCURRENCY=4

# --- Observability ----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
